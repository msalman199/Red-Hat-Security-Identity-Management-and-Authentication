Task 2: Configure Replication and DNS
Subtask 2.1: Install First Replica Server
Step 1: Join Replica1 as Client First
# On idm-replica1.example.com
# Configure DNS to point to primary server
echo "nameserver 192.168.1.10" > /etc/resolv.conf

# Join as IdM client
ipa-client-install \
  --server=idm-primary.example.com \
  --domain=example.com \
  --realm=EXAMPLE.COM \
  --principal=admin \
  --password=RedHat123! \
  --unattended
Step 2: Promote Client to Replica
# Authenticate as admin
kinit admin

# Install replica with DNS
ipa-replica-install \
  --setup-dns \
  --forwarder=8.8.8.8 \
  --forwarder=8.8.4.4 \
  --unattended
Step 3: Verify Replica1 Installation
# Check services status
systemctl status ipa

# Verify replication
ipa-replica-manage list
ipa-csreplica-manage list

# Test authentication
kinit admin
ipa user-find admin
Subtask 2.2: Install Second Replica Server
Step 1: Join Replica2 as Client
# On idm-replica2.example.com
# Configure DNS
echo "nameserver 192.168.1.10" > /etc/resolv.conf

# Join as IdM client
ipa-client-install \
  --server=idm-primary.example.com \
  --domain=example.com \
  --realm=EXAMPLE.COM \
  --principal=admin \
  --password=RedHat123! \
  --unattended
Step 2: Promote to Replica
# Authenticate
kinit admin

# Install replica with DNS
ipa-replica-install \
  --setup-dns \

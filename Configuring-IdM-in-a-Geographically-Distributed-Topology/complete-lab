# Wait for replication (usually 1-2 minutes)
sleep 120

# Check if replica1user exists on replica2
ssh root@idm-replica2.example.com
kinit admin
ipa user-show replica1user

# Check if replica2user exists on replica1
ssh root@idm-replica1.example.com
kinit admin
ipa user-show replica2user

# Restart primary server and check data
ssh root@idm-primary.example.com

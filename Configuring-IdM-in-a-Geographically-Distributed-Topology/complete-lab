Troubleshooting Common Issues
Issue 1: Replication Not Working
# Check replication agreements
ipa-replica-manage list -v

# Restart replication
ipa-replica-manage re-initialize --from=idm-primary.example.com

# Check logs
tail -f /var/log/dirsrv/slapd-EXAMPLE-COM/errors
Issue 2: DNS Resolution Problems
# Verify DNS configuration
ipa dnsconfig-show

# Check DNS zones
ipa dnszone-find

# Test DNS resolution
dig @localhost example.com SOA
Issue 3: Certificate Issues
# Check certificate status
ipa-cacert-manage list

# Renew certificates if needed
ipa-cacert-manage renew

# Check CA replication
ipa-csreplica-manage list
Validation and Testing
Final Validation Steps
Step 1: Comprehensive Topology Test
# Create validation script
cat > /tmp/validate_topology.sh << 'EOF'
#!/bin/bash
echo "=== IdM Distributed Topology Validation ==="

echo "1. Checking all servers status..."
for server in idm-primary.example.com idm-replica1.example.com idm-replica2.example.com; do
    echo "Checking $server..."
    ssh root@$server "systemctl is-active ipa" || echo "$server: FAILED"
done

echo "2. Testing authentication on all servers..."
for server in idm-primary.example.com idm-replica1.example.com idm-replica2.example.com; do
    echo "Testing auth on $server..."
    ssh root@$server "echo 'RedHat123!' | kinit admin" || echo "$server auth: FAILED"
done

echo "3. Testing data consistency..."
ssh root@idm-primary.example.com "ipa user-find --all | wc -l"
ssh root@idm-replica1.example.com "ipa user-find --all | wc -l"
ssh root@idm-replica2.example.com "ipa user-find --all | wc -l"

echo "4. Testing DNS resolution..."
for server in idm-primary.example.com idm-replica1.example.com idm-replica2.example.com; do
    nslookup $server || echo "DNS resolution failed for $server"
done

echo "=== Validation Complete ==="
EOF

chmod +x /tmp/validate_topology.sh
/tmp/validate_topology.sh

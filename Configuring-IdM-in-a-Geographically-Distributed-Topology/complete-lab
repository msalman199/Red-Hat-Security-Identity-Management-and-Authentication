Subtask 2.3: Configure DNS Topology
Step 1: Verify DNS Configuration
# On primary server, check DNS zones
ipa dnszone-find

# Verify DNS records for all servers
dig idm-primary.example.com
dig idm-replica1.example.com
dig idm-replica2.example.com
Step 2: Configure DNS Load Balancing
# Add DNS records for load balancing
ipa dnsrecord-add example.com ipa --a-rec=192.168.1.10
ipa dnsrecord-add example.com ipa --a-rec=192.168.1.11
ipa dnsrecord-add example.com ipa --a-rec=192.168.1.12

# Verify the records
ipa dnsrecord-show example.com ipa
Subtask 2.4: Configure Replication Topology
Step 1: Check Current Topology
# On any IdM server, check replication topology
ipa topologysegment-find domain

# Check CA replication topology
ipa topologysegment-find ca
Step 2: Optimize Replication Topology
# Create additional replication agreements for better redundancy
ipa topologysegment-add domain replica1-to-replica2 \
  --leftnode=idm-replica1.example.com \
  --rightnode=idm-replica2.example.com

# Verify the new topology
ipa topologysegment-find domain
Task 3: Test the Distributed Topology for High Availability
Subtask 3.1: Create Test Data
Step 1: Create Test Users and Groups
# On primary server, create test data
kinit admin

# Create test users
ipa user-add testuser1 --first=Test --last=User1 --password
ipa user-add testuser2 --first=Test --last=User2 --password
ipa user-add testuser3 --first=Test --last=User3 --password

# Create test group
ipa group-add testgroup --desc="Test Group for HA Testing"

# Add users to group
ipa group-add-member testgroup --users=testuser1,testuser2,testuser3
Step 2: Verify Data Replication
# Check data on replica1
ssh root@idm-replica1.example.com
kinit admin
ipa user-find testuser1
ipa group-show testgroup

# Check data on replica2
ssh root@idm-replica2.example.com
kinit admin
ipa user-find testuser2
ipa group-show testgroup
Subtask 3.2: Test High Availability Scenarios
Step 1: Test Primary Server Failure
# Simulate primary server failure
ssh root@idm-primary.example.com
systemctl stop ipa

# Test operations from replica1
ssh root@idm-replica1.example.com
kinit admin

# Try to create a new user
ipa user-add hatest1 --first=HA --last=Test1 --password

# Verify the user was created
ipa user-show hatest1
Step 2: Test DNS Failover
# From a client machine or replica, test DNS resolution
nslookup idm-primary.example.com
nslookup idm-replica1.example.com

# Test service discovery
dig _ldap._tcp.example.com SRV
dig _kerberos._tcp.example.com SRV
Step 3: Test Authentication Failover
# Configure a test client to use multiple servers
echo "192.168.1.11 idm-replica1.example.com" >> /etc/hosts
echo "192.168.1.12 idm-replica2.example.com" >> /etc/hosts

# Test authentication against different servers
kinit -S host/idm-replica1.example.com testuser1
kinit -S host/idm-replica2.example.com testuser2
Subtask 3.3: Test Data Consistency
Step 1: Create Data on Different Replicas
# Create user on replica1
ssh root@idm-replica1.example.com
kinit admin
ipa user-add replica1user --first=Replica1 --last=User --password

# Create user on replica2
ssh root@idm-replica2.example.com

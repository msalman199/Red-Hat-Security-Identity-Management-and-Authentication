Subtask 3.4: Performance and Load Testing
Step 1: Test Concurrent Operations
# Create a script to test concurrent user creation
cat > /tmp/load_test.sh << 'EOF'
#!/bin/bash
for i in {1..10}; do
    ipa user-add loadtest$i --first=Load --last=Test$i --password &
done
wait
echo "Load test completed"
EOF

chmod +x /tmp/load_test.sh

# Run load test on different servers simultaneously
ssh root@idm-replica1.example.com "/tmp/load_test.sh" &
ssh root@idm-replica2.example.com "/tmp/load_test.sh" &
wait
Step 2: Monitor Replication Status
# Check replication status

Security Best Practices
Subtask 3.8: Implement Security Hardening
# Set strong OTP policies
ipa otpconfig-mod --totp-auth-window=1 --totp-sync-window=5

# Configure account lockout policies
ipa pwpolicy-mod --maxfail=3 --failinterval=300

# Enable audit logging
sudo systemctl enable rsyslog
sudo systemctl start rsyslog

# Configure log monitoring
sudo tee /etc/rsyslog.d/50-ipa-2fa.conf << EOF
# IPA 2FA Logging
local4.*    /var/log/ipa-2fa.log
EOF

sudo systemctl restart rsyslog

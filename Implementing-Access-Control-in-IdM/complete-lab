ipa user-show developer1 --all
ipa user-show testadmin --all
Subtask 2.2: Configure Advanced Access Policies
Create time-based access restrictions:
# Create a rule for business hours access
ipa hbacrule-add business_hours_access \
  --desc="Allow access only during business hours"

# Add users group
ipa hbacrule-add-user business_hours_access --groups=users

# Add hosts
ipa hbacrule-add-host business_hours_access --hosts=client1.example.com

# Add services
ipa hbacrule-add-service business_hours_access --hbacsvcs=sshd
Create service-specific restrictions:
# Create a rule that denies sudo access to regular users
ipa hbacrule-add no_sudo_users \
  --desc="Explicitly deny sudo access to regular users"

# This rule will be used to demonstrate explicit denial
# Note: In FreeIPA, denial is typically handled by not including 
# the service in allowed rules rather than explicit denial rules
Configure host-specific policies:
# Create a rule for server access (admins only)
ipa hbacrule-add server_access_only \
  --desc="Only administrators can access the IdM server"

# Add only admins group
ipa hbacrule-add-user server_access_only --groups=admins

# Add only the IdM server
ipa hbacrule-add-host server_access_only --hosts=idm-server.example.com

# Add all services for admins on the server
ipa hbacrule-add-service server_access_only --hbacsvcs=sshd
ipa hbacrule-add-service server_access_only --hbacsvcs=login
ipa hbacrule-add-service server_access_only --hbacsvcs=su
ipa hbacrule-add-service server_access_only --hbacsvcs=sudo
Subtask 2.3: Implement Conditional Access Policies
Create external group mappings (if using external authentication):
# Example of creating external group mapping
# This would be used if integrating with Active Directory or LDAP

# Create external group
ipa group-add external_contractors \
  --desc="External contractors with limited access" \
  --external

# Create corresponding HBAC rule
ipa hbacrule-add contractor_access \
  --desc="Limited access for external contractors"

ipa hbacrule-add-user contractor_access --groups=external_contractors

Subtask 4.3: Test High Availability and Failover
Step 1: Test client failover scenario

Create a test script on all servers:

# Create failover test script
sudo tee /root/test-failover.sh << 'EOF'
#!/bin/bash

echo "Testing IdM server availability..."

# Test each server
for server in idm-primary.lab.local idm-replica1.lab.local idm-replica2.lab.local; do
    echo "Testing $server..."
    
    # Test LDAP connectivity
    if ldapsearch -x -H ldap://$server -b "dc=lab,dc=local" -s base > /dev/null 2>&1; then
        echo "  LDAP: OK"
    else
        echo "  LDAP: FAILED"
    fi
    
    # Test DNS
    if nslookup lab.local $server > /dev/null 2>&1; then
        echo "  DNS: OK"
    else
        echo "  DNS: FAILED"
    fi
    
    # Test HTTP
    if curl -k https://$server/ipa/ui/ > /dev/null 2>&1; then
        echo "  Web UI: OK"
    else
        echo "  Web UI: FAILED"
    fi
    
    echo ""
done
EOF

# Make script executable
sudo chmod +x /root/test-failover.sh
Step 2: Run baseline test

Execute on any server:

# Run failover test
sudo /root/test-failover.sh

ipa dnsrecord-add lab.local idm-replica2 --a-rec=192.168.1.12

# Add reverse DNS records
ipa dnsrecord-add 1.168.192.in-addr.arpa. 11 --ptr-rec=idm-replica1.lab.local.
ipa dnsrecord-add 1.168.192.in-addr.arpa. 12 --ptr-rec=idm-replica2.lab.local.

# Verify DNS records
ipa dnsrecord-find lab.local

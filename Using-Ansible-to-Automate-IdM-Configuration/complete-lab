Task 3: Execute Playbooks for System-Wide Configuration
Subtask 3.1: Create Master Configuration Playbook
Create a comprehensive master playbook that orchestrates all configurations:
cat > playbooks/master_idm_config.yml << 'EOF'
---
- name: Complete IdM System Configuration
  hosts: idm_servers
  become: no
  gather_facts: yes
  
  vars:
    backup_location: /var/lib/ipa/backup
    
  pre_tasks:
    - name: Create backup of current IdM configuration
      shell: |
        ipa-backup --data --online
      register: backup_result
      changed_when: backup_result.rc == 0

    - name: Display backup information
      debug:
        msg: "Backup created: {{ backup_result.stdout_lines[-1] if backup_result.stdout_lines else 'Backup may have failed' }}"

  tasks:
    - name: Import group management tasks
      include: manage_groups.yml

    - name: Import user management tasks  
      include: manage_users.yml

    - name: Import server configuration tasks
      include: configure_idm_server.yml

    - name: Import HBAC configuration tasks
      include: configure_hbac.yml

    - name: Configure IdM client auto-enrollment
      freeipa.ansible_freeipa.ipaconfig:
        ipaadmin_principal: "{{ ipaadmin_principal }}"
        ipaadmin_password: "{{ ipaadmin_password }}"
        enable_migration: yes
        defaultshell: /bin/bash
        defaultgroup: ipausers
        homedirectory: /home

    - name: Configure certificate profiles
      freeipa.ansible_freeipa.ipacertprofile:
        ipaadmin_principal: "{{ ipaadmin_principal }}"
        ipaadmin_password: "{{ ipaadmin_password }}"
        name: WebServerCert
        description: "Certificate profile for web servers"
        store: yes
        state: present

  post_tasks:
    - name: Verify IdM server status
      shell: ipactl status
      register: idm_status
      changed_when: false

    - name: Display IdM service status
      debug:
        var: idm_status.stdout_lines

    - name: Generate configuration report
      shell: |
        echo "=== IdM Configuration Report ===" > /tmp/idm_config_report.txt
        echo "Date: $(date)" >> /tmp/idm_config_report.txt
        echo "" >> /tmp/idm_config_report.txt
        echo "Users:" >> /tmp/idm_config_report.txt
        ipa user-find --raw | grep "uid:" >> /tmp/idm_config_report.txt
        echo "" >> /tmp/idm_config_report.txt
        echo "Groups:" >> /tmp/idm_config_report.txt
        ipa group-find --raw | grep "cn:" >> /tmp/idm_config_report.txt
        echo "" >> /tmp/idm_config_report.txt
        echo "HBAC Rules:" >> /tmp/idm_config_report.txt
        ipa hbacrule-find --raw | grep "cn:" >> /tmp/idm_config_report.txt
      register: report_generation

    - name: Fetch configuration report
      fetch:
        src: /tmp/idm_config_report.txt
        dest: ./reports/
        flat: yes
EOF
Subtask 3.2: Create Client Enrollment Playbook
Create a playbook to configure IdM clients:
cat > playbooks/configure_idm_clients.yml << 'EOF'
---
- name: Configure IdM Clients
  hosts: client-machine
  become: yes
  gather_facts: yes
  
  vars:
    idm_server: idm-server.example.com
    idm_domain: example.com
    idm_realm: EXAMPLE.COM
    
  tasks:
    - name: Install IdM client packages
      yum:
        name:
          - ipa-client
          - ipa-admintools
        state: present

    - name: Configure DNS to point to IdM server
      lineinfile:
        path: /etc/resolv.conf
        line: "nameserver {{ hostvars['idm-server']['ansible_default_ipv4']['address'] }}"
        insertbefore: BOF

    - name: Enroll client with IdM server
      shell: |
        ipa-client-install \
          --server={{ idm_server }} \
          --domain={{ idm_domain }} \
          --realm={{ idm_realm }} \
          --principal=admin \
          --password={{ ipaadmin_password }} \
          --unattended \
          --force-join
      register: client_enrollment
      changed_when: client_enrollment.rc == 0

    - name: Configure SSSD for IdM authentication
      lineinfile:
        path: /etc/sssd/sssd.conf
        regexp: "{{ item.regexp }}"
        line: "{{ item.line }}"
        backup: yes
      loop:
        - { regexp: '^cache_credentials', line: 'cache_credentials = True' }
        - { regexp: '^krb5_store_password_if_offline', line: 'krb5_store_password_if_offline = True' }
        - { regexp: '^enumerate', line: 'enumerate = True' }
      notify: restart_sssd

    - name: Configure PAM for home directory creation
      lineinfile:
        path: /etc/pam.d/system-auth
        line: "session required pam_mkhomedir.so skel=/etc/skel umask=077"
        insertafter: "session.*pam_unix.so"

  handlers:
    - name: restart_sssd
      systemd:
        name: sssd
        state: restarted
        enabled: yes
EOF

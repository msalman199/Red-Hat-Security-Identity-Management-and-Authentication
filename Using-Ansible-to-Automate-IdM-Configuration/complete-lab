Subtask 3.5: Create Automated Maintenance Tasks
Create a maintenance playbook for ongoing IdM management:
cat > playbooks/idm_maintenance.yml << 'EOF'
---
- name: IdM Maintenance Tasks
  hosts: idm_servers
  become: no
  gather_facts: yes
  
  vars:
    log_retention_days: 30
    backup_retention_days: 7
    
  tasks:
    - name: Clean old log files
      find:
        paths: /var/log/dirsrv
        age: "{{ log_retention_days }}d"
        file_type: file
      register: old_logs

    - name: Remove old log files
      file:
        path: "{{ item.path }}"
        state: absent
      loop: "{{ old_logs.files }}"
      when: old_logs.files is defined

    - name: Clean old backup files
      find:
        paths: /var/lib/ipa/backup
        age: "{{ backup_retention_days }}d"
        file_type: file
        patterns: "ipa-full-*"
      register: old_backups

    - name: Remove old backup files
      file:
        path: "{{ item.path }}"
        state: absent
      loop: "{{ old_backups.files }}"
      when: old_backups.files is defined

    - name: Check certificate expiration
      shell: |
        ipa cert-find --all | grep -A5 -B5 "Serial number"
      register: cert_check
      changed_when: false

    - name: Update CRL (Certificate Revocation List)
      shell: ipa-crlgen-manage enable
      register: crl_update
      changed_when: crl_update.rc == 0

    - name: Compact database
      shell: |
        systemctl stop dirsrv@EXAMPLE-COM.service
        /usr/bin/db_checkpoint -1 -h /var/lib/dirsrv/slapd-EXAMPLE-COM/db
        /usr/bin/db_archive -d -h /var/lib/dirsrv/slapd-EXAMPLE-COM/db
        systemctl start dirsrv@EXAMPLE-COM.service
      register: db_maintenance
      changed_when: db_maintenance.rc == 0
EOF

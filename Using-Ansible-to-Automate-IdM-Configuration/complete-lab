Task 2: Use Ansible to Configure IdM Server Settings
Subtask 2.1: Create IdM Server Configuration Playbook
Create a comprehensive server configuration playbook:
cat > playbooks/configure_idm_server.yml << 'EOF'
---
- name: Configure IdM Server Settings
  hosts: idm_servers
  become: no
  gather_facts: yes
  
  vars:
    password_policy_settings:
      - name: global_policy
        minlength: 12
        maxlife: 90
        minlife: 1
        history: 5
        minclasses: 3
        maxfail: 3
        failinterval: 60
        lockouttime: 600

    sudo_rules:
      - name: developers_sudo
        description: "Allow developers sudo access to development servers"
        users:
          - john.doe
          - bob.wilson
        hosts:
          - dev-server.example.com
        commands:
          - /usr/bin/systemctl
          - /usr/bin/docker
      - name: admin_full_sudo
        description: "Full sudo access for administrators"
        users:
          - jane.smith
        hosts:
          - ALL
        commands:
          - ALL

    dns_zones:
      - name: dev.example.com
        state: present
      - name: test.example.com
        state: present

  tasks:
    - name: Configure global password policy
      freeipa.ansible_freeipa.ipapwpolicy:
        ipaadmin_principal: "{{ ipaadmin_principal }}"
        ipaadmin_password: "{{ ipaadmin_password }}"
        name: "{{ item.name }}"
        minlength: "{{ item.minlength }}"
        maxlife: "{{ item.maxlife }}"
        minlife: "{{ item.minlife }}"
        history: "{{ item.history }}"
        minclasses: "{{ item.minclasses }}"
        maxfail: "{{ item.maxfail }}"
        failinterval: "{{ item.failinterval }}"
        lockouttime: "{{ item.lockouttime }}"
        state: present
      loop: "{{ password_policy_settings }}"

    - name: Create sudo rules
      freeipa.ansible_freeipa.ipasudorule:
        ipaladmin_principal: "{{ ipaadmin_principal }}"
        ipaadmin_password: "{{ ipaadmin_password }}"
        name: "{{ item.name }}"
        description: "{{ item.description }}"
        user: "{{ item.users }}"
        host: "{{ item.hosts }}"
        command: "{{ item.commands }}"
        state: present
      loop: "{{ sudo_rules }}"

    - name: Configure DNS zones
      freeipa.ansible_freeipa.ipadnszone:
        ipaadmin_principal: "{{ ipaadmin_principal }}"
        ipaadmin_password: "{{ ipaadmin_password }}"
        name: "{{ item.name }}"
        state: "{{ item.state }}"
      loop: "{{ dns_zones }}"

    - name: Enable IdM services
      freeipa.ansible_freeipa.ipaconfig:
        ipaadmin_principal: "{{ ipaadmin_principal }}"
        ipaadmin_password: "{{ ipaadmin_password }}"
        enable_migration: yes
        defaultshell: /bin/bash
        defaultgroup: ipausers
EOF
Subtask 2.2: Create Host-Based Access Control (HBAC) Rules
Create HBAC configuration playbook:
cat > playbooks/configure_hbac.yml << 'EOF'
---
- name: Configure Host-Based Access Control Rules
  hosts: idm_servers
  become: no
  gather_facts: no
  
  vars:
    hbac_rules:
      - name: developers_dev_access
        description: "Allow developers access to development servers"
        users:
          - john.doe
          - bob.wilson
        groups:
          - developers
        hosts:
          - dev-server.example.com
        services:
          - sshd
          - login
      - name: admin_all_access
        description: "Allow administrators access to all systems"
        users:
          - jane.smith
        groups:
          - administrators
        hosts:
          - ALL
        services:
          - sshd
          - login
          - su
          - sudo

    services_to_create:
      - name: docker
        description: "Docker service access"
      - name: kubernetes
        description: "Kubernetes service access"

  tasks:
    - name: Create custom services
      freeipa.ansible_freeipa.ipahbacsvc:
        ipaadmin_principal: "{{ ipaadmin_principal }}"
        ipaadmin_password: "{{ ipaadmin_password }}"
        name: "{{ item.name }}"
        description: "{{ item.description }}"
        state: present
      loop: "{{ services_to_create }}"

    - name: Create HBAC rules
      freeipa.ansible_freeipa.ipahbacrule:
        ipaadmin_principal: "{{ ipaadmin_principal }}"
        ipaadmin_password: "{{ ipaadmin_password }}"
        name: "{{ item.name }}"
        description: "{{ item.description }}"
        user: "{{ item.users | default(omit) }}"
        group: "{{ item.groups | default(omit) }}"
        host: "{{ item.hosts }}"
        hbacsvc: "{{ item.services }}"
        state: present
      loop: "{{ hbac_rules }}"

    - name: Disable default allow_all rule
      freeipa.ansible_freeipa.ipahbacrule:
        ipaadmin_principal: "{{ ipaadmin_principal }}"
        ipaadmin_password: "{{ ipaadmin_password }}"
        name: allow_all
        state: disabled
EOF

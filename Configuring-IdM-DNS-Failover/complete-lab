curl -k https://idm-server2.example.com/ipa/ui/

# Test API access
curl -k -H "Accept: application/json" https://idm-server2.example.com/ipa/json
Subtask 3.3: Verify DNS Service Continuity
Test DNS queries for all IdM services:
# Create comprehensive DNS test script
cat > /tmp/dns_service_test.sh << 'EOF'
#!/bin/bash
echo "Testing DNS service continuity..."

services=("_ldap._tcp" "_kerberos._tcp" "_kerberos-master._tcp" "_kpasswd._tcp" "_ntp._tcp")

for service in "${services[@]}"; do
    echo "Testing $service.example.com:"
    nslookup $service.example.com
    echo "---"
done

echo "Testing reverse DNS:"
nslookup 192.168.1.11

echo "Testing external DNS resolution:"
nslookup google.com

echo "DNS service test completed."
EOF

chmod +x /tmp/dns_service_test.sh
/tmp/dns_service_test.sh
Monitor DNS performance during failover:
# Test DNS response times
for i in {1..10}; do
    echo "Test $i:"
    time nslookup example.com
    sleep 2
done
Verify DNS zone transfers and replication:
# On idm-server2, check zone transfer logs
sudo journalctl -u named-pkcs11 -f &

# From client1, perform DNS operations that trigger replication
sudo ipa dnsrecord-add example.com testrecord --a-rec=192.168.1.100

# Verify record was added
nslookup testrecord.example.com
Subtask 3.4: Test Recovery and Failback
Restore primary server (idm-server1):
# On idm-server1, restart IdM services
sudo ipactl start

# Verify all services are running
sudo ipactl status

# Check DNS service specifically
sudo systemctl status named-pkcs11
Test failback behavior:
# From client1, test DNS resolution returns to primary
nslookup example.com

# Monitor which server responds
dig +short example.com @192.168.1.10
dig +short example.com @192.168.1.11
Verify data consistency after recovery:
# Check that test records exist on both servers
sudo ipa dnsrecord-show example.com testrecord

# Verify user accounts are synchronized
sudo ipa user-show testuser1

# Test authentication against both servers
kinit -S krbtgt/EXAMPLE.COM@EXAMPLE.COM testuser1
Troubleshooting Common Issues
DNS Resolution Problems
If DNS resolution fails during testing:

# Check DNS service status
sudo systemctl status named-pkcs11

# Verify DNS configuration
sudo named-checkconf /etc/named.conf

# Check DNS logs
sudo journalctl -u named-pkcs11 -n 50

# Test DNS manually
dig @localhost example.com
Authentication Failures
If authentication fails during failover:

# Check Kerberos configuration
cat /etc/krb5.conf

# Verify KDC connectivity
kinit -V admin

# Check time synchronization
chrony sources -v

# Test LDAP connectivity
ldapsearch -x -H ldap://idm-server2.example.com -b "dc=example,dc=com" "(uid=admin)"
Replication Issues
If data is not synchronized between servers:

# Check replication status
sudo ipa-replica-manage list
sudo ipa-replica-manage list-ruv

# Force replication
sudo ipa-replica-manage force-sync --from idm-server1.example.com

# Check replication agreements
sudo ipa-replica-manage list -v idm-server2.example.com

sudo nano /usr/local/bin/ipa-connectivity-test.sh
Add the following content:

#!/bin/bash
# IPA Connectivity Test Script

IPA_SERVER="ipa.example.com"
PORTS=(88 389 636 443 464)

echo "=== IPA Connectivity Test ==="
echo "Testing connectivity to: $IPA_SERVER"
echo

for port in "${PORTS[@]}"; do
    echo -n "Testing port $port: "
    if timeout 5 bash -c "echo >/dev/tcp/$IPA_SERVER/$port" 2>/dev/null; then
        echo "OPEN"
    else
        echo "CLOSED/FILTERED"
    fi
done

echo
echo "--- Network Route to IPA Server ---"
traceroute -n $IPA_SERVER | head -10

echo
echo "--- Ping Test ---"
ping -c 3 $IPA_SERVER
